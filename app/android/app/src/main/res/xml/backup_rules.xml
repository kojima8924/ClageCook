<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- API keys are protected by Android Keystore and must never be restored
         without their device-bound wrapping key. Conversations are local-only. -->
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
