# Official API keys (BYOK). Never commit backend/.env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# 安全のため既定OFF。実APIを呼ぶときだけ true へ変更してください。
CLAGE_LIVE_API_ENABLED=false

# Required when CLAGE_LIVE_API_ENABLED=true. Also use it whenever listening on
# LAN or Tailscale. The server refuses to arm live APIs without authentication.
CLAGE_AUTH_TOKEN=

# A data directory can be moved to a private local disk. Never share one data
# directory between server processes; the server enforces a single owner.
# CLAGE_DATA_DIR=C:\private\clage-cook-data

# Provider/model policy. The defaults follow current official model families.
SYNTHESIZER_PROVIDER=auto
# Optional synthesis-only overrides. Leave unset to use the selected provider's
# worker model for the same tier.
# SYNTHESIZER_MODEL_LOW=
# SYNTHESIZER_MODEL_BALANCED=
# SYNTHESIZER_MODEL_HIGH=
# CLAUDE_MODEL_LOW=claude-haiku-4-5-20251001
# CLAUDE_MODEL_BALANCED=claude-sonnet-5
# CLAUDE_MODEL_HIGH=claude-opus-4-8
# GEMINI_MODEL_LOW=gemini-3.1-flash-lite
# GEMINI_MODEL_BALANCED=gemini-3.5-flash
# GEMINI_MODEL_HIGH=gemini-3.5-flash
# CHATGPT_MODEL_LOW=gpt-5.6-luna
# CHATGPT_MODEL_BALANCED=gpt-5.6-terra
# CHATGPT_MODEL_HIGH=gpt-5.6-sol
# GROK_MODEL_LOW=grok-4.3
# GROK_MODEL_BALANCED=grok-4.3
# GROK_MODEL_HIGH=grok-4.5

# With one or more real keys, missing providers are excluded by default.
# Set true only when you explicitly want real and mock answers mixed together.
INCLUDE_MOCK_PROVIDERS=false

# Security/cost/latency limits.
# Browser origins allowed in addition to localhost/127.0.0.1.
# Example: CLAGE_CORS_ORIGINS=https://clage-cook.example
CLAGE_CORS_ORIGINS=
# CLAGE_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
MAX_CONCURRENT_RUNS=2
RATE_LIMIT_PER_MINUTE=10
HTTP_TIMEOUT_SEC=180
# Optional deterministic mock latency used only by SAFE MOCK providers.
MOCK_DELAY_SEC=0.08
# Generation requests are not safely idempotent after a lost response.
# Keep this at 0 unless you also raise and review the per-run safety envelope.
HTTP_RETRIES=0
MAX_MESSAGE_CHARS=50000
MAX_OUTPUT_TOKENS_LOW=1200
MAX_OUTPUT_TOKENS_BALANCED=2400
MAX_OUTPUT_TOKENS_HIGH=4000
MAX_PROVIDER_CALLS_PER_RUN=9
MAX_OUTPUT_TOKENS_PER_RUN=36000
MAX_INPUT_BYTES_PER_RUN=3200000
HISTORY_TURNS=10
HISTORY_MAX_CHARS=60000
PEER_MAX_CHARS=12000
SSE_PING_SEC=15
RUN_RETENTION_SEC=3600

# Optional server-side Web search. Each turn remains OFF unless WEB/!web is used.
# Search tools may have charges separate from model tokens. Only Claude receives
# a strict max_uses value; other providers may run multiple internal searches.
CLAGE_WEB_SEARCH_ENABLED=true
CLAGE_WEB_SEARCH_MAX_USES=3

# Opaque conversation-owned attachments and local conversation memory.
CLAGE_ATTACHMENT_MAX_BYTES=10485760
CLAGE_ATTACHMENT_MAX_COUNT_PER_CONVERSATION=20
CLAGE_ATTACHMENT_MAX_TOTAL_BYTES_PER_CONVERSATION=52428800
CLAGE_ATTACHMENT_MAX_PER_TURN=8
CLAGE_ATTACHMENT_TTL_SEC=2592000
CLAGE_ATTACHMENT_TEXT_MAX_CHARS=100000
CLAGE_ATTACHMENT_TOTAL_TEXT_MAX_CHARS=200000
CLAGE_ATTACHMENT_PDF_MAX_PAGES=50
CLAGE_CONVERSATION_MEMORY_MAX_CHARS=20000

# Optional local price/budget guard. Pricing is intentionally never guessed.
# Copy pricing.example.json to a private file, enter the exact prices from your
# provider contracts, then point CLAGE_PRICE_TABLE_FILE at that file.
# CLAGE_PRICE_TABLE_FILE=C:\private\clage-pricing.json
# CLAGE_PER_RUN_BUDGET_USD=1.00
# CLAGE_DAILY_BUDGET_USD=5.00
# Missing model/rate entries block live runs whenever a budget is enabled.
CLAGE_BUDGET_UNKNOWN_POLICY=block
# Fixed daily-boundary offset. Japan: +09:00
CLAGE_BUDGET_UTC_OFFSET=+00:00
# Fail closed when crash/timeout reservations awaiting reconciliation accumulate.
CLAGE_MAX_UNRECONCILED_RESERVATIONS=10

# Optional read-only organization telemetry. These credentials are separate
# from inference keys. Enabling this feature also requires CLAGE_AUTH_TOKEN.
# With the default false value, these endpoints are never contacted.
CLAGE_ADMIN_TELEMETRY_ENABLED=false
CLAGE_ADMIN_TELEMETRY_CACHE_SEC=300
CLAGE_ADMIN_TELEMETRY_LOOKBACK_DAYS=7
CLAGE_ADMIN_TELEMETRY_TIMEOUT_SEC=15
# Anthropic organization Admin API key (sk-ant-admin...), not ANTHROPIC_API_KEY.
ANTHROPIC_ADMIN_KEY=
# OpenAI organization Admin API key, not OPENAI_API_KEY.
OPENAI_ADMIN_KEY=
# xAI Management API key, not XAI_API_KEY.
XAI_MANAGEMENT_KEY=
# Optional. If omitted, a team-scoped management key is validated to find it.
XAI_TEAM_ID=
